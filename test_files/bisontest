function createNode(value){
    return [
        {"val": value},
        {"next": nil}
    ];
}

function createList(){
    return [
        {"head":nil},
        {"tail":nil},
        {"len":0},
        {"append":
            (
                function(self, element){
                    node = createNode(element);
                    if(self.head==nil){
                        self.head = node;
                        self.tail = self.head;
                        self.len = self.len + 1;
                        return;
                    }
                    self.tail.next = node;
                    self.tail = node;
                    self.len = self.len + 1;
                }
            )
        },
        {"prepend":
            (
                function(self, element){
                    node = createNode(element);
                    if(self.head==nil){
                        self.tail = node;
                    }
                    node.next = self.head;
                    self.head = node;
                    self.len = self.len + 1;
                }
            )
        },
        {"length":
            (
                function(self){
                    return self.len;
                }
            )
        },
        {"toString":
            (
                function(self){
                    it = self.head;
                    while(it!=nil){
                        print(it.val);
                        it = it.next;
                    }
                }
            )
        }
    ];
}

list = createList();
list..append(1);
list..append(4);
list..prepend(9);
list..toString();

